# Copie este arquivo para .env (desenvolvimento) e configure as mesmas
# variáveis no painel do seu provedor de hospedagem (ex: Vercel) em produção.
# Nunca comite o arquivo .env de verdade — ele fica de fora do git (.gitignore).

# --- Banco de dados (Postgres) ---
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# --- OpenPix (https://developers.openpix.com.br) ---
# AppID da sua conta OpenPix. Nunca exponha essa credencial no frontend —
# ela só é lida no backend (lib/openpix/client.ts). Enquanto estiver vazia,
# os endpoints de cobrança respondem com erro de configuração (503), nunca
# com um "sucesso" simulado.
OPENPIX_APP_ID=""
# https://api.openpix.com.br em produção, https://api.woovi-sandbox.com para testes.
OPENPIX_API_URL="https://api.openpix.com.br"
# String secreta definida ao cadastrar o Webhook na OpenPix (dashboard ou
# API). A OpenPix devolve esse mesmo valor no header Authorization de cada
# chamada ao endpoint /api/webhooks/openpix — é isso que valida a origem.
OPENPIX_WEBHOOK_AUTHORIZATION=""

# --- Sessão do painel administrativo ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
ADMIN_EMAIL="admin@example.com"
# Gere com: node -e "require('bcryptjs').hash('sua-senha', 10).then(console.log)"
# IMPORTANTE: hashes bcrypt contêm "$" (ex: $2b$10$...). O carregador de env
# do Next.js expande "$ALGO" como se fosse referência a outra variável, então
# escape cada "$" como "\$" dentro do .env, assim: ADMIN_PASSWORD_HASH="\$2b\$10\$..."
ADMIN_PASSWORD_HASH=""
