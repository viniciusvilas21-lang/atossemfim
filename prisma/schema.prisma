generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CarouselOverride {
  AUTO
  FORCE_SHOW
  FORCE_HIDE
}

enum DonationStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum SubscriptionStatus {
  PENDING_AUTHORIZATION
  ACTIVE
  REJECTED
  CANCELED
}

enum SubscriptionChargeStatus {
  CREATED
  AUTHORIZED
  PAID
  EXPIRED
  FAILED
}

// A person who donated once and/or became a monthly maintainer.
// One Supporter row per person (matched by e-mail), reused across
// one-time donations and the monthly subscription.
model Supporter {
  id                String           @id @default(cuid())
  fullName          String
  whatsapp          String
  instagram         String?
  email             String           @unique
  cpf               String? // only ever collected/required for the monthly flow
  displayName       String?
  allowPublicDisplay Boolean         @default(false)
  marketingOptIn    Boolean          @default(false)
  acceptedPrivacyAt DateTime
  carouselOverride  CarouselOverride @default(AUTO)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  donations     Donation[]
  subscriptions Subscription[]

  @@index([allowPublicDisplay])
}

model Donation {
  id                  String         @id @default(cuid())
  supporterId         String
  supporter           Supporter      @relation(fields: [supporterId], references: [id])
  amount              Int // ofertado, em centavos
  fee                 Int // taxa cobrada, em centavos (0 se não optou por cobrir)
  totalAmount         Int // amount + fee, o que de fato é cobrado na cobrança Pix
  openpixCorrelationId String        @unique
  openpixChargeId     String?
  openpixGlobalId     String?
  brCode              String?
  qrCodeImage         String?
  paymentLinkUrl      String?
  status              DonationStatus @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([supporterId])
  @@index([status])
}

model Subscription {
  id                        String             @id @default(cuid())
  supporterId               String
  supporter                 Supporter          @relation(fields: [supporterId], references: [id])
  amount                    Int
  fee                       Int
  totalAmount               Int
  billingDay                Int
  status                    SubscriptionStatus @default(PENDING_AUTHORIZATION)
  openpixSubscriptionGlobalId String?          @unique
  openpixCorrelationId     String?             @unique
  authorizedAt              DateTime?
  canceledAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                  DateTime          @updatedAt

  charges SubscriptionCharge[]

  @@index([supporterId])
  @@index([status])
}

// One row per monthly billing cycle generated by OpenPix for a Subscription.
model SubscriptionCharge {
  id                    String                   @id @default(cuid())
  subscriptionId        String
  subscription          Subscription             @relation(fields: [subscriptionId], references: [id])
  openpixCorrelationId String                    @unique
  openpixChargeId      String?
  amount                Int
  status                SubscriptionChargeStatus @default(CREATED)
  paidAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([subscriptionId])
}

// Every OpenPix webhook delivery, kept for idempotency and audit history.
model WebhookEvent {
  id          String    @id @default(cuid())
  dedupeKey   String    @unique
  eventType   String
  rawPayload  Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventType])
}

// Admin-editable key/value configuration (transaction fee, prayer group link, etc.)
// so these can change without a code deploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
